{
  "description": "Safari Only: Command+Backtick switches windows via Command+Shift+Backtick",
  "manipulators": [
    {
      "type": "basic",
      "from": {
        "key_code": "grave_accent_and_tilde",
        "modifiers": {
          "mandatory": [
            "command"
          ],
          "optional": []
        }
      },
      "to": [
        {
          "key_code": "grave_accent_and_tilde",
          "modifiers": [
            "command",
            "shift"
          ]
        }
      ],
      "conditions": [
        {
          "type": "frontmost_application_if",
          "bundle_identifiers": [
            "^com\\.apple\\.Safari$"
          ]
        }
      ]
    }
  ]
}
